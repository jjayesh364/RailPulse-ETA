# RailPulse ETA - Environment Configuration
# Copy this file to .env and modify as needed

# Database
DATABASE_URL=sqlite+aiosqlite:///./railpulse.db

# Application Mode
DEMO_MODE=true

# Simulation
SIMULATION_INTERVAL=3

# ML Model
ML_MODEL_PATH=../ml/model/eta_model.joblib

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
